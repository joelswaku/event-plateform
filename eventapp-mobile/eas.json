{
  "cli": {
    "version": ">= 19.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:5000/api"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-staging.liteevent.com/api"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.liteevent.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://liteevent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "728056596746-bgeh855s1c8t9snrg5l09kp1vvu2uvqd.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "728056596746-44c4q2vgaiojan8imrs50ikkjmg3e8d0.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "728056596746-bgeh855s1c8t9snrg5l09kp1vvu2uvqd.apps.googleusercontent.com"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "production-ios": {
      "extends": "production",
      "ios": {
        "simulator": false
      }
    },
    "production-android": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "joelswaku@gmail.com",
        "ascAppId": "6801724090",
        "appleTeamId": "853YU44W52"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
